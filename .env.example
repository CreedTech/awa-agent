# ============================================================
# AwaAgent - Environment variables
# Copy to `.env.local` and adjust. Only NEXT_PUBLIC_* reach the browser.
# ============================================================

# --- Branding ---
NEXT_PUBLIC_APP_NAME=AwaAgent
NEXT_PUBLIC_APP_URL=https://awaagent.ng
NEXT_PUBLIC_SUPPORT_EMAIL=support@awaagent.ng
NEXT_PUBLIC_SUPPORT_PHONE=0700 292 224 368
NEXT_PUBLIC_CURRENCY=₦
NEXT_PUBLIC_DEFAULT_CITY=Ibadan

# --- Business rules (tunable) ---
NEXT_PUBLIC_ESCROW_FEE_PCT=2.5
NEXT_PUBLIC_RENEWAL_ESCROW_FEE_PCT=1
NEXT_PUBLIC_DEFAULT_COMMISSION_PCT=9
NEXT_PUBLIC_MAX_INSPECTIONS_PER_DAY=4
NEXT_PUBLIC_OTP_RESEND_SECONDS=30

# --- Backend integration ---
# The backend mounts these routes under /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://api.awaagent.ng/api/v1
